@ccuHost = {{$dotenv CCU_HOST}}
@ccuUser = {{$dotenv CCU_USER}}
@ccuPassword = {{$dotenv CCU_PASSWORD}}
@rpcUrl = http://{{ccuHost}}/api/homematic.cgi

### 1) Session login – obtain session ID
# @name login
POST {{rpcUrl}}
Content-Type: application/json

{
  "method": "Session.login",
  "params": ["{{ccuUser}}", "{{ccuPassword}}"],
  "id": 1,
  "version": "1.1"
}

{{
  exports.sessionId = response.parsedBody?.result;
}}

### 2) Get all devices
# @ref login
@sessionId = REPLACE_WITH_SESSION_ID
POST {{rpcUrl}}
Content-Type: application/json

{
  "method": "Domain.getInitData",
  "params": ["{{sessionId}}"],
  "id": 2,
  "version": "1.1"
}

### 3) Get device by ID
POST {{rpcUrl}}
Content-Type: application/json

{
  "method": "Interface.listDevices",
  "params": ["{{sessionId}}", "BidCos-RF"],
  "id": 3,
  "version": "1.1"
}

### 4) Get all rooms (channels + rooms assignment)
POST {{rpcUrl}}
Content-Type: application/json

{
  "method": "Room.getAll",
  "params": ["{{sessionId}}"],
  "id": 4,
  "version": "1.1"
}

### 5) Session logout
POST {{rpcUrl}}
Content-Type: application/json

{
  "method": "Session.logout",
  "params": ["{{sessionId}}"],
  "id": 5,
  "version": "1.1"
}
